# Server API base URL. Leave empty to use the same-origin /api path locally.
VITE_API_BASE_URL=/api

# Local Vite proxy target used when VITE_API_BASE_URL is a relative path.
VITE_API_PROXY_TARGET=http://localhost:8080

# Optional map provider key. The provider SDK is intentionally not enabled yet.
VITE_MAP_PROVIDER_API_KEY=

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=10000
